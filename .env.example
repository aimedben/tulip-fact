# Copier ce fichier vers .env puis adapter les chemins.
# Ne jamais versionner .env : il peut contenir une clÃ© LLM.

# --- Application ---
TULIP_APP_MODE=production
TULIP_HOST=0.0.0.0
TULIP_PORT=8000
# Laisser vide pour data/ en production et data/demo en mode demo.
TULIP_DATA_DIR=
# DATABASE_URL=sqlite:///C:/Users/Thinkpad/tulip-factures/data/tulip_factures.db

# --- Import ---
TULIP_MAX_UPLOAD_MB=25
TULIP_AMOUNT_TOLERANCE=0.05
TULIP_DISABLE_WORKER=false

# --- OCR local ---
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TULIP_TESSERACT_LANGS=fra+eng
TESSDATA_PREFIX=C:\Users\Thinkpad\tulip-factures\tessdata
TULIP_OCR_PSM=6
TULIP_OCR_DPI=300
TULIP_PREVIEW_DPI=140

# --- OCR spÃ©cialisÃ© GOT-OCR2 (optionnel, 100% local) ---
# Petit modÃ¨le vision (~580M) entraÃ®nÃ© sur documents/tickets. ~1,5 Go tÃ©lÃ©chargÃ©
# une fois puis mis en cache ; infÃ©rence locale, lente sur CPU (quelques s/page).
# auto : utilisÃ© seulement en repli si les moteurs rapides Ã©chouent.
# got : force GOT-OCR2 pour toutes les pages.
# TULIP_OCR_ENGINE=auto  # auto | got | rapidocr | tesseract | mistral
TULIP_GOT_OCR_ENABLED=false
TULIP_GOT_OCR_MODEL=stepfun-ai/GOT-OCR2_0
# Cache du modÃ¨le : laisser vide pour le cache Hugging Face par dÃ©faut.
# Si le disque par dÃ©faut manque de place, un disque avec >3 Go libres est choisi.
TULIP_GOT_CACHE_DIR=

# --- Extraction LLM optionnelle ---
# DÃ©sactivÃ©e par dÃ©faut. Aucun document n'est transmis sans activation explicite.
TULIP_LLM_ENABLED=false
TULIP_LLM_API_KEY=
TULIP_LLM_BASE_URL=https://api.openai.com/v1
TULIP_LLM_MODEL=gpt-4o-mini
TULIP_LLM_TIMEOUT=60

# --- Tulip ---
# export_only : production de fichiers locaux, sans Ã©criture dans Tulip.
TULIP_INTEGRATION_MODE=export_only

# Automatisation d'interface prÃ©sente mais dÃ©sactivÃ©e par dÃ©faut.
TULIP_UI_AUTOMATION_ENABLED=false
TULIP_UI_WINDOW_TITLE=Tulip Gestion commerciale
TULIP_UI_EXE=

# --- Firebird Tulip ---
# DÃ©sactivÃ© par dÃ©faut. Renseigner le mot de passe uniquement dans .env local.
# Le client isql fourni avec Tulip est en 32 bits : ne pas le remplacer par un binaire 64 bits.
# Pour tester l'Ã©criture : pointer TULIP_FB_DATABASE vers une COPIE de la base
# (jamais la production), puis passer TULIP_FB_WRITE_ENABLED=true.
TULIP_FB_ENABLED=true
TULIP_FB_HOST=localhost
TULIP_FB_PORT=3050
TULIP_FB_DATABASE=
TULIP_FB_USER=SYSDBA
TULIP_FB_PASSWORD=
TULIP_FB_ISQL_PATH=
TULIP_FB_HOME=
TULIP_FB_CHARSET=WIN1252
TULIP_FB_TIMEOUT=60
# Ã‰criture BE validÃ©e sur copie uniquement : laisser false tant que
# TULIP_FB_DATABASE ne pointe pas sur une copie. En production : false.
TULIP_FB_WRITE_ENABLED=false
TULIP_OCR_ENGINE=auto

